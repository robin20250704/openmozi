# ============================================================
# OpenMozi AI 客服系统 P1 环境变量
# 位置：D:\project\ai-sales\runtime\openmozi\.env
# 加载：dotenv.config()（launcher 顶部）
# 注意：.env 不要提交到版本控制
# ============================================================

# ============================================================
# §1 LLM Provider（主力 + 兜底）
# ============================================================
# 主力：MiniMax M3（OpenAI 兼容 API，通过 provider=minimax + 模型 ID）
# 兜底：DeepSeek（OpenAI 兼容）
# OpenMozi config.local.json5 中 provider 选 minimax，模型选 MiniMax-M3

# MiniMax（主力）
MINIMAX_API_KEY=eyJ-your-minimax-key-here     # 必填（用户填）
MINIMAX_GROUP_ID=your_minimax_group_id         # MiniMax 部分模型需要 GroupID（abab 系列）
MINIMAX_BASE_URL=https://api.minimax.chat/v1   # 默认即可（OpenMozi 预置）
MINIMAX_MODEL=MiniMax-M3                       # m3 模型 ID

# DeepSeek（兜底）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here     # 可选
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI（备用兜底）
OPENAI_API_KEY=sk-your-openai-key-here          # 可选
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Agent 行为参数（inject 到 system_prompt + launcher）
AGENT_TEMPERATURE=0.3                          # 客服场景偏低，更确定
AGENT_MAX_TOKENS=2048
AGENT_DEFAULT_PROVIDER=minimax                  # 选 minimax
AGENT_DEFAULT_MODEL=MiniMax-M3                  # 选 m3

# ============================================================
# §2 IM 渠道（C-039 + 各种 Channel Adapter）
# ============================================================
# OpenMozi 原生支持的渠道：wecom（企微）/ feishu（飞书）/ dingtalk（钉钉）/ qq
# 自研渠道（P2）：wechat-mp（公众号）/ email / h5

# --- 企业微信（OpenMozi 原生，P1 主力） ---
WECOM_ENABLED=true
WECOM_CORP_ID=your_wecom_corp_id
WECOM_CORP_SECRET=your_wecom_corp_secret
WECOM_AGENT_ID=your_wecom_agent_id
WECOM_TOKEN=your_wecom_token
WECOM_ENCODING_AES_KEY=your_wecom_encoding_aes_key
WECOM_CALLBACK_URL=https://your-public-domain.com/wecom/callback
WECOM_WELCOME_MSG=您好，我是君无忧 AI 客服小君🌿，消杀服务问题随时问我～

# --- 微信公众号（自研 Channel，P2） ---
WECHAT_MP_ENABLED=false
WECHAT_MP_APP_ID=your_wechat_mp_app_id
WECHAT_MP_APP_SECRET=your_wechat_mp_app_secret
WECHAT_MP_TOKEN=your_wechat_mp_token
WECHAT_MP_ENCODING_AES_KEY=your_wechat_mp_encoding_aes_key
WECHAT_MP_CALLBACK_URL=https://your-public-domain.com/wechat-mp/callback

# --- 飞书（OpenMozi 原生，P2） ---
FEISHU_ENABLED=false
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_VERIFICATION_TOKEN=your_verification_token
FEISHU_ENCRYPT_KEY=your_encrypt_key

# --- 钉钉（OpenMozi 原生，P2） ---
DINGTALK_ENABLED=false
DINGTALK_APP_KEY=your_dingtalk_app_key
DINGTALK_APP_SECRET=your_dingtalk_app_secret
DINGTALK_ROBOT_CODE=your_robot_code

# --- QQ 官方机器人（OpenMozi 原生，P2） ---
QQ_ENABLED=false
QQ_APP_ID=your_qq_app_id
QQ_CLIENT_SECRET=your_qq_client_secret
QQ_SANDBOX=false

# --- 邮件（自研 Channel，P2） ---
EMAIL_ENABLED=false
EMAIL_IMAP_HOST=imap.qq.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=your_email
EMAIL_IMAP_PASSWORD=your_email_password
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=your_email
EMAIL_SMTP_PASSWORD=your_email_password
EMAIL_POLL_INTERVAL=30

# ============================================================
# §3 业务后端连接
# ============================================================
PG_HOST=127.0.0.1
PG_PORT=35432
PG_USER=openmozi
PG_PASSWORD=openmozi_dev_only
PG_DATABASE=openmozi

SCHEDULER_API_URL=http://127.0.0.1:35801
SCHEDULER_API_KEY=dev_only_token_replace_in_prod

JUNWUYOU_API_URL=http://127.0.0.1:53000
JUNWUYOU_ADMIN_TOKEN=

# ============================================================
# §4 BGE 模型路径（D14）
# ============================================================
BGE_EMBED_PATH=C:/Users/Administrator/.mozi/models/bge-small-zh-v1.5
BGE_RERANK_PATH=C:/Users/Administrator/.mozi/models/bge-reranker-base

# ============================================================
# §5 OpenMozi 运行时
# ============================================================
OPENMOZI_PORT=33000
OPENMOZI_CONTROL_PORT=32468
OPENMOZI_HOST=0.0.0.0
LOG_LEVEL=info
MOZI_SKILLS_USER_DIR=C:/Users/Administrator/.mozi/skills
MOZI_PLUGINS_PATH=C:/Users/Administrator/.mozi/plugins

# ============================================================
# §6 业务开关（可选）
# ============================================================
LLM_FALLBACK_ENABLED=true
FAQ_HIT_RATE_ALERT_THRESHOLD=0.70
ROUTER_REDLINE_KEYWORDS_EXTRA=
HUMAN_HANDOFF_THRESHOLD=0.5

# �������ݣ�Web UI ����/��ӭ�Ĭ�� С�� / �����ǣ�
ASSISTANT_NAME=С��
ASSISTANT_COMPANY=������
