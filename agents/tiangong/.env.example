# agents/tiangong/.env.example —— 小天的运行凭据模板（可入库；真实凭据在 `.env`，已 gitignore）
#
# 复制成 `.env` 后填值；launcher 启动时按 `agents/<id>/.env` 自动注入（不覆盖已有环境变量）。
# 详细说明见 `.env` 内注释与 `docs/openmozi-multi-agent-deployment-guide.md` §七之二。

# ── 模型（kimi-for-coding；provider 由描述符 llmProfile 声明）──
# pi 内置 provider `kimi-coding`（baseUrl https://api.kimi.com/coding，anthropic-messages 协议）。
# 键名沿用 DSH 口径 KIMI_CODING_API_KEY；launcher 会同步成 KIMI_API_KEY 作兜底。
KIMI_CODING_API_KEY=

# ── PLM 系统（UAT）凭据 ────────────────────────────────────────
PLM_BASE=https://120.25.103.162:8722
PLM_REALM=plm
PLM_CLIENT_ID=plm-web
PLM_USER=
PLM_PASSWORD=
PLM_DEFAULT_PROJECT_ID=87

# ── 浏览器 SSO（专用端口，避免复用外部 Chrome 实例静默挂死）──
PLM_CDP_PORT=9334
PLM_HEADLESS=true
PLM_SESSION_CACHE=.cache/plm-session.json
